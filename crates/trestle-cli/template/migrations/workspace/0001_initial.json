            "check_name": "workspaces_name_check"
          },
          {
            "id": "workspace.workspace.created_at",
            "column": "created_at",
            "type": "timestamptz",
            "nullable": false,
            "default": {
              "kind": "now"
            }
          }
        ]
      }
    },
    {
      "op": "create_model",
      "model": {
        "id": "workspace.membership",
        "table": "workspace_memberships",
        "fields": [
          {
            "id": "workspace.membership.workspace_id",
            "column": "workspace_id",
            "type": "uuid",
