{
  "name": "trestle-frontend",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "client",
    "interaction-react",
    "admin-react",
    "product",
    "admin"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:packages && npm run build --workspace product && npm run build --workspace admin",
    "e2e": "node e2e/run-demo.mjs",
    "build:packages": "node build-packages.mjs",
    "pretest": "npm run build:packages",
    "build:views": "npm run build:packages && node build-views.mjs",
    "test:packages": "node test-packages.mjs",
    "test:views": "npm run build:views && node e2e/run-views.mjs",
    "test:compatibility": "node test-compatibility.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  }
}
