+#[test]
+fn review_production_allows_unverified_database_tls() {
+    let mut config = ServeConfig::for_tests();
+    config.dev_tokens = None;
+    config.cursor_key = Some("a cursor key with at least thirty two bytes".into());
+    config.session_key = Some("a session key with at least thirty two bytes".into());
+    config.password_login = true;
+    config.public_origin = vec!["https://app.example.com".into()];
+    config.trust_peer_address = true;
+    for mode in ["require", "verify-ca"] {
+        let db = format!("postgres://pilot@db.internal/pilot?sslmode={mode}").parse().unwrap();
+        let problems = config.problems(Environment::Production, &db);
+        println!("Production TLS {mode} boot problems: {problems:?}");
+        assert!(problems.is_empty());
+    }
+}
