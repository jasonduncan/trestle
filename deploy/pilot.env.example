# Production environment for `pilot serve` (see docs/runbooks/deploy.md).
# Secrets come from the secret store at deploy time; never commit values.
TRESTLE_ENV=production
TRESTLE_BIND=0.0.0.0:8000
TRESTLE_METRICS_BIND=10.0.0.11:9464            # private interface only

# Runtime credentials (separate from the migration role, §16.2).
# A non-local database must use sslmode=verify-full; production boot refuses
# require and verify-ca, which do not authenticate the server.
DATABASE_URL=postgres://pilot_runtime@db.internal/pilot?sslmode=verify-full&sslrootcert=/etc/trestle/db-ca.pem
TRESTLE_DB_POOL_SIZE=10
TRESTLE_STATEMENT_TIMEOUT_MS=10000

# At least 32 random bytes each, e.g. `openssl rand -base64 48`. Rotating the
# cursor key invalidates open list cursors; rotating the session key
# invalidates CSRF tokens (clients re-fetch them from /api/v1/auth/session).
TRESTLE_CURSOR_KEY=
TRESTLE_SESSION_KEY=

# Password accounts (operator-issued invite and reset links).
TRESTLE_PASSWORD_LOGIN=true
# All accounts together, per client address (schools share one address).
TRESTLE_PASSWORD_ATTEMPTS_PER_MINUTE=60

# Outgoing email for `pilot account … --send` and `pilot mail test`.
# smtps:// (TLS) or smtp:// (STARTTLS required). Percent-encode credentials.
TRESTLE_EMAIL_URL=smtps://mailer:PASSWORD@smtp.example.com
TRESTLE_EMAIL_FROM=Trestle Pilot <no-reply@example.com>
# TRESTLE_EMAIL_CA_FILE=/etc/trestle/smtp-ca.pem   # only for a private CA

# OpenID Connect (optional; the pilot signs in with password accounts above).
# TRESTLE_OIDC_ISSUER=https://id.example.com
# TRESTLE_OIDC_CLIENT_ID=pilot-web
# TRESTLE_OIDC_CLIENT_SECRET=
# TRESTLE_OIDC_SCOPES=openid
# Only if API clients use provider-issued JWT access tokens:
# TRESTLE_OIDC_API_AUDIENCE=https://api.example.com
TRESTLE_PUBLIC_ORIGIN=https://app.example.com

# Perimeter (per replica).
TRESTLE_MAX_IN_FLIGHT=256
# Time a client has to send a whole request body (408 after; default 10 s).
TRESTLE_BODY_TIMEOUT_MS=10000
TRESTLE_RATE_PER_SECOND=20
TRESTLE_RATE_BURST=40
TRESTLE_CLIENT_ADDRESS_HEADER=X-Real-IP

RUST_LOG=info
