# Copy to .env for local development. Placeholders only: never commit .env.
DATABASE_URL=postgres://localhost/{{name}}
TRESTLE_ENV=development
TRESTLE_PUBLIC_ORIGIN=http://localhost:8000
# Development bearer tokens: token=actor-uuid,... (refused in production)
TRESTLE_DEV_TOKENS=
# At least 32 random bytes each. Required for password sign-in.
TRESTLE_SESSION_KEY=
TRESTLE_CURSOR_KEY=
# Only with [auth] oidc = "google":
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
