+#[cfg(test)]
+mod security_review_probe {
+    use super::*;
+    #[tokio::test]
+    async fn review_stale_key_has_no_maximum_age() {
+        use jsonwebtoken::{EncodingKey, Header, encode};
+        let signing = EncodingKey::from_rsa_pem(include_bytes!(
+            "../../../examples/pilot/tests/fixtures/idp-test-rsa.pem"
+        )).unwrap();
+        let jwk = Jwk::from_encoding_key(&signing, Algorithm::RS256).unwrap();
+        let keys = Jwks::new(Url::parse("https://unused.invalid/jwks").unwrap());
+        {
+            let mut state = keys.state.lock().unwrap();
+            state.keys = Arc::new(vec![usable(&jwk).unwrap()]);
+            state.fetched = Some(Instant::now() - Duration::from_secs(30 * 24 * 3600));
+            // Model the state immediately after the last refresh failed:
+            // old keys persist, and retries are suppressed for 30 seconds.
+            state.attempted = Some(Instant::now());
+        }
+        let provider = Provider {
+            issuer: "https://issuer.example".into(),
+            authorization_endpoint: Url::parse("https://issuer.example/authorize").unwrap(),
+            token_endpoint: Url::parse("https://issuer.example/token").unwrap(),
+            jwks: keys,
+            http: client().unwrap(),
+        };
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs();
+        let token = encode(&Header::new(Algorithm::RS256), &serde_json::json!({
+            "iss": provider.issuer, "aud": "review-api", "sub": "review-actor", "exp": now + 600
+        }), &signing).unwrap();
+        assert!(provider.verify(&token, "review-api").await.is_ok());
+        println!("Fresh token accepted using a signing key last fetched 30 days ago");
+    }
+}
 
