# Copy to .env (gitignored) or export these in your shell.
DATABASE_URL=postgres://localhost/trestle_dev
TRESTLE_ENV=development
TRESTLE_BIND=127.0.0.1:8000
# Development-only bearer tokens (token=actor-uuid). Refused when TRESTLE_ENV=production.
# These match the fixtures created by `cargo run -p pilot -- seed-dev`.
TRESTLE_DEV_TOKENS=alice-dev-token=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa,bob-dev-token=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb,carol-dev-token=cccccccc-cccc-4ccc-8ccc-cccccccccccc,olivia-dev-token=dddddddd-dddd-4ddd-8ddd-dddddddddddd
RUST_LOG=info,pilot=debug,trestle_core=debug
