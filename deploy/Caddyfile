# Edge for the Trestle pilot (design doc §12.2, §16.1). `make drill-edge`
# runs this file in a real Caddy on one machine, in front of two
# production-mode replicas (docs/evidence/edge-drill.json). Still unproven on
# a real host: ACME certificates, DNS, real client addresses and the
# firewalling of the admin API and metrics listener.
#
# One public origin. Static bundles come from disk (or a CDN in front of
# this edge); /api and /_meta go to the API replicas. The edge never
# rewrites an unknown /api or /_meta path to the SPA entry document, never
# caches personalised responses, and never exposes /metrics.
#
# Replace app.example.com, the upstream addresses and the asset roots.
{
	# Keep the admin API off the network.
	admin localhost:2019
	servers {
		timeouts {
			# A client gets this long for its headers, and for the whole
			# request including the body (Caddy has no limit by default).
			# The API has its own total body deadline
			# (TRESTLE_BODY_TIMEOUT_MS, 10 s); this one also covers
			# connections that never reach it.
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
}

app.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# The bundles load only same-origin scripts, styles and data.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# API and metadata: always upstream, never cached here, never the SPA.
	@api path /api/* /_meta/*
	handle @api {
		# The API's own limit (1 MiB): larger bodies stop here (413).
		request_body {
			max_size 1MB
		}
		reverse_proxy 10.0.0.11:8000 10.0.0.12:8000 {
			lb_policy least_conn
			# A replica that refuses the connection (stopped, restarting) is
			# skipped within the same request. Caddy retries only GETs, or
			# requests that never reached a replica, so no write runs twice.
			lb_try_duration 5s
			# Stop sending to a replica that is draining or not migrated.
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			# The API rate-limits unauthenticated clients by this header
			# (TRESTLE_CLIENT_ADDRESS_HEADER=X-Real-IP). Overwrite, never append.
			header_up X-Real-IP {remote_host}
			header_up -X-Forwarded-For
		}
	}

	# Health and metrics stay internal: the orchestrator probes replicas
	# directly and Prometheus scrapes TRESTLE_METRICS_BIND on the private
	# network.
	@internal path /healthz /readyz /metrics
	handle @internal {
		respond 404
	}

	# Admin shell (built with base /admin/). Same origin, so it shares the
	# host-only session cookie and the login callback.
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/trestle/admin
		# Entry document revalidated; hashed assets immutable. The matchers
		# must not overlap: Caddy orders repeated `header` directives by
		# matcher, not by position, and runs an unmatched one last.
		@admin_assets path /assets/*
		header @admin_assets Cache-Control "public, max-age=31536000, immutable"
		@admin_entry not path /assets/*
		header @admin_entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Product bundle: hashed assets are immutable; the entry document is
	# revalidated on every load so a rollout reaches new sessions promptly.
	@assets path /assets/*
	handle @assets {
		root * /srv/trestle/product
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/trestle/product
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
